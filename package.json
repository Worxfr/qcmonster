{
  "name": "qcmonster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["web"],
  "engines": { "node": ">=22" },
  "scripts": {
    "gen": "tsx scripts/gen-contract.ts",
    "gen:check": "npm run gen && git diff --exit-code -- shared/contract/generated",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "synth": "cd infra && cdk synth --quiet",
    "mock": "prism mock -p 4010 -h 127.0.0.1 shared/contract/openapi.yaml",
    "mock:check": "tsx mock/check.ts",
    "build:web": "npm run build -w web"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@stoplight/prism-cli": "^5.14.0",
    "@types/aws-lambda": "^8.10.0",
    "@types/node": "^22.0.0",
    "@apidevtools/json-schema-ref-parser": "^11.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "aws-cdk": "^2",
    "aws-cdk-lib": "^2",
    "constructs": "^10",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "json-schema-to-zod": "^2.6.0",
    "openapi-typescript": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.6.0"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "zod": "^3.24.0"
  }
}
