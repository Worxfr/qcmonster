{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["api", "shared", "infra", "mock", "scripts", "eval", "golden", "vitest.config.ts"],
  "exclude": ["node_modules", "cdk.out", "web", "e2e"]
}
